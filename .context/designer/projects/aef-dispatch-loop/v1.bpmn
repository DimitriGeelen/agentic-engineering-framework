<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:aef="http://anchorpoint.framework/aef/extensions"
                  id="Definitions_aef-dispatch-loop"
                  targetNamespace="https://aef.anchorpoint.dev/workflows">

  <!-- designer-corpus D4 (arc-014, T-2563): the v1 dispatch-orchestration loop as
       actually operated. Sources of truth: fw resolver dispatch (workflow → assemble →
       telemetry, .context/dispatches.jsonl), fw termlink dispatch (kill watchdog,
       T-577), fw bus post/manifest (result ledger), paused-dispatch chain
       (dispatch-safety arc slice 5: pause_requested → fw pause resolve →
       retry_of_dispatch_id), fw outcome evaluate/backprop (dispatch-outcomes.jsonl).
       Message flavor: the orchestrator observes worker results via the bus — the one
       honest kind=message typed event. Pair-draft v1. -->

  <bpmn:collaboration id="Collaboration_aef-dispatch-loop">
    <bpmn:participant id="Pool_dispatch_loop" name="AEF dispatch-orchestration loop" processRef="Process_aef-dispatch-loop"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_aef-dispatch-loop" isExecutable="true">
    <bpmn:extensionElements>
      <aef:workflowMeta id="aef-dispatch-loop" version="1" schemaVersion="2" title="AEF dispatch-orchestration loop (resolver dispatch → worker → outcome backprop, with pause chain)" tier_default="1"/>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_dl">
      <bpmn:lane id="agent" name="Agent · Initiative">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="agt" authority="initiative" height="260"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>agt_start_task</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_1_fw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_2_spawn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_message_worker</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_gw_worker</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_4_re</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_3_fw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_end_loop</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="human" name="Human · Sovereignty">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="hum" authority="sovereignty" height="160"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>hum_1_operator</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="agt_start_task" name="task selected for dispatch">
      <bpmn:extensionElements>
        <aef:uid value="dl_start"/>
        <aef:position x="120.0" y="120.0"/>
        <aef:meta triggeredBy="resolver pick, operator ask, or orchestrated demo (arc-010); main agent delegates bounded sub-tasks via fw resolver run"/>
      </bpmn:extensionElements>
      <bpmn:outgoing>dl_f1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="agt_1_fw" name="fw resolver dispatch — match workflow, assemble envelope, telemetry to dispatches.jsonl">
      <bpmn:extensionElements>
        <aef:uid value="dl_resolve"/>
        <aef:position x="260.0" y="120.0"/>
        <aef:meta note="envelope is the forensic unit: fw resolver explain &lt;dispatch_id&gt; reconstructs any captured dispatch"/>
      </bpmn:extensionElements>
      <bpmn:incoming>dl_f1</bpmn:incoming>
      <bpmn:outgoing>dl_f2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="agt_2_spawn" name="spawn isolated worker — fw termlink dispatch (task-tagged, kill watchdog T-577)">
      <bpmn:extensionElements>
        <aef:uid value="dl_spawn"/>
        <aef:position x="440.0" y="120.0"/>
        <aef:meta note="TermLink worker = independent process, zero parent-context cost; writes results to repo targets, posts to fw bus (T-818)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>dl_f2</bpmn:incoming>
      <bpmn:incoming>dl_f8_retry</bpmn:incoming>
      <bpmn:outgoing>dl_f3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:intermediateCatchEvent id="agt_message_worker" name="worker result on bus">
      <bpmn:extensionElements>
        <aef:uid value="dl_msg_result"/>
        <aef:position x="620.0" y="120.0"/>
        <aef:eventDef kind="message" binding="bus:task-channel"/>
        <aef:meta note="fw bus post → orchestrator reads manifest (5 lines, not 25KB); size gate auto-blobs &gt;=2KB payloads"/>
      </bpmn:extensionElements>
      <bpmn:incoming>dl_f3</bpmn:incoming>
      <bpmn:outgoing>dl_f4</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:exclusiveGateway id="agt_gw_worker" name="worker paused?">
      <bpmn:extensionElements>
        <aef:uid value="dl_gw_paused"/>
        <aef:position x="780.0" y="120.0"/>
        <aef:meta note="pause_requested = worker hit a question only the operator can answer (dispatch-safety arc slice 5)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>dl_f4</bpmn:incoming>
      <bpmn:outgoing>dl_f5</bpmn:outgoing>
      <bpmn:outgoing>dl_f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="hum_1_operator" name="operator resolves pause — fw pause resolve &lt;dispatch_id&gt; --answer">
      <bpmn:extensionElements>
        <aef:uid value="dl_pause_resolve"/>
        <aef:position x="780.0" y="340.0"/>
        <aef:meta note="sovereignty boundary: the worker asked, only the human answers; fw pause list surfaces the queue"/>
      </bpmn:extensionElements>
      <bpmn:incoming>dl_f5</bpmn:incoming>
      <bpmn:outgoing>dl_f7</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="agt_4_re" name="re-dispatch retry envelope — linked via retry_of_dispatch_id">
      <bpmn:extensionElements>
        <aef:uid value="dl_retry"/>
        <aef:position x="960.0" y="200.0"/>
        <aef:meta note="the retry is a NEW envelope carrying the operator's answer, chained to the paused one for forensics"/>
      </bpmn:extensionElements>
      <bpmn:incoming>dl_f7</bpmn:incoming>
      <bpmn:outgoing>dl_f8_retry</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="agt_3_fw" name="fw outcome evaluate + backprop — outcome rows joined to dispatch rows (dispatch-outcomes.jsonl)">
      <bpmn:extensionElements>
        <aef:uid value="dl_outcome"/>
        <aef:position x="960.0" y="60.0"/>
        <aef:meta note="best-effort hook also fires from update-task.sh on work-completed; fw outcome read joins both JSONL files"/>
      </bpmn:extensionElements>
      <bpmn:incoming>dl_f6</bpmn:incoming>
      <bpmn:outgoing>dl_f9</bpmn:outgoing>
      <bpmn:outgoing>dl_f10</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="agt_end_loop" name="loop closed — dispatch + outcome queryable">
      <bpmn:extensionElements>
        <aef:uid value="dl_done"/>
        <aef:position x="1120.0" y="60.0"/>
        <aef:meta terminalKind="success" state="closed"/>
      </bpmn:extensionElements>
      <bpmn:incoming>dl_f9</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:intermediateThrowEvent id="lan_link_handoff" name="Handoff → task lifecycle">
      <bpmn:extensionElements>
        <aef:uid value="dl_handoff_back"/>
        <aef:position x="1120.0" y="180.0"/>
        <aef:link workflowRef="1f9b5f0c-0be4-4cfe-9158-d9e6f0c1d4c7" name="aef-task-lifecycle" linkId=""/>
        <aef:meta note="dispatch outcome lands back in the owning task — status/AC updates continue in aef-task-lifecycle (return leg of the tl_handoff_dispatch jump; T-2600)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>dl_f10</bpmn:incoming>
    </bpmn:intermediateThrowEvent>

    <bpmn:sequenceFlow id="dl_f1" sourceRef="agt_start_task" targetRef="agt_1_fw">
      <bpmn:extensionElements><aef:uid value="dl_e1"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="dl_f2" sourceRef="agt_1_fw" targetRef="agt_2_spawn">
      <bpmn:extensionElements><aef:uid value="dl_e2"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="dl_f3" sourceRef="agt_2_spawn" targetRef="agt_message_worker">
      <bpmn:extensionElements><aef:uid value="dl_e3"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="dl_f4" sourceRef="agt_message_worker" targetRef="agt_gw_worker">
      <bpmn:extensionElements><aef:uid value="dl_e4"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="dl_f5" name="yes — pause_requested" sourceRef="agt_gw_worker" targetRef="hum_1_operator">
      <bpmn:extensionElements><aef:uid value="dl_e5"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="dl_f6" name="no — completed" sourceRef="agt_gw_worker" targetRef="agt_3_fw">
      <bpmn:extensionElements><aef:uid value="dl_e6"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="dl_f7" sourceRef="hum_1_operator" targetRef="agt_4_re">
      <bpmn:extensionElements><aef:uid value="dl_e7"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="dl_f8_retry" name="retry envelope" sourceRef="agt_4_re" targetRef="agt_2_spawn">
      <bpmn:extensionElements><aef:uid value="dl_e8"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="dl_f9" sourceRef="agt_3_fw" targetRef="agt_end_loop">
      <bpmn:extensionElements><aef:uid value="dl_e9"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="dl_f10" name="outcome → owning task" sourceRef="agt_3_fw" targetRef="lan_link_handoff">
      <bpmn:extensionElements><aef:uid value="dl_e10"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
  </bpmn:process>
</bpmn:definitions>
