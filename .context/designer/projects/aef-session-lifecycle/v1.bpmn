<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:aef="http://anchorpoint.framework/aef/extensions"
                  id="Definitions_aef-session-lifecycle"
                  targetNamespace="https://aef.anchorpoint.dev/workflows">

  <!-- designer-corpus D3 (arc-014, T-2561): the AEF session lifecycle as actually
       operated. Sources of truth: CLAUDE.md §Session Start Protocol, §Context Budget
       Management (P-009, 225K/255K/285K ladder), §Session End Protocol, §Auto-Restart
       (T-179: signal file → wrapper sleep 3 → claude -c), T-1277 push-verify.
       Telemetry pick #3: handover ran 1387×. Timer flavor: the auto-restart cancel
       window is the one honest kind=timer in this process. Pair-draft v1. -->

  <bpmn:collaboration id="Collaboration_aef-session-lifecycle">
    <bpmn:participant id="Pool_session_lifecycle" name="AEF session lifecycle" processRef="Process_aef-session-lifecycle"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_aef-session-lifecycle" isExecutable="true">
    <bpmn:extensionElements>
      <aef:workflowMeta id="aef-session-lifecycle" version="1" schemaVersion="2" title="AEF session lifecycle (init → work loop → budget wrap-up → handover → push-verify)" tier_default="1"/>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_sl">
      <bpmn:lane id="human" name="Human · Sovereignty">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="hum" authority="sovereignty" height="160"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>hum_0_launch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hum_8_review</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="agent" name="Agent · Initiative">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="agt" authority="initiative" height="260"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>agt_1_init</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_2_work</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_gw_budget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_3_capture</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_4_handover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_5_verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_gw_restart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_tmr_restart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_9_restarted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_10_closed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="hum_0_launch" name="operator launches session (claude-fw)">
      <bpmn:extensionElements>
        <aef:uid value="sl_launch"/>
        <aef:position x="120.0" y="100.0"/>
        <aef:meta triggeredBy="operator starts claude-fw (optionally --termlink); wrapper owns the restart loop (T-179)"/>
      </bpmn:extensionElements>
      <bpmn:outgoing>sl_f1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="agt_1_init" name="session init — fw context init, read LATEST.md handover, set focus (Session Start Protocol)">
      <bpmn:extensionElements>
        <aef:uid value="sl_init"/>
        <aef:position x="260.0" y="300.0"/>
        <aef:meta note="Suggested First Action from handover; fw metrics for project state; post-compaction variant is fw resume status/sync"/>
      </bpmn:extensionElements>
      <bpmn:incoming>sl_f1</bpmn:incoming>
      <bpmn:outgoing>sl_f2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="agt_2_work" name="work loop — task-gated work, commit cadence P-009 (commit every meaningful unit, 15-20 min)">
      <bpmn:extensionElements>
        <aef:uid value="sl_work"/>
        <aef:position x="440.0" y="300.0"/>
        <aef:meta note="nothing without a task (Tier-1 gate); each commit is a checkpoint — work up to last commit survives context loss"/>
      </bpmn:extensionElements>
      <bpmn:incoming>sl_f2</bpmn:incoming>
      <bpmn:incoming>sl_f3_loop</bpmn:incoming>
      <bpmn:outgoing>sl_f4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="agt_gw_budget" name="budget critical?">
      <bpmn:extensionElements>
        <aef:uid value="sl_gw_budget"/>
        <aef:position x="620.0" y="300.0"/>
        <aef:meta note="P-009 ladder 225K ok→warn / 255K warn→urgent / 285K urgent→critical; budget-gate.sh BLOCKS source writes at critical — wrap-up only"/>
      </bpmn:extensionElements>
      <bpmn:incoming>sl_f4</bpmn:incoming>
      <bpmn:outgoing>sl_f3_loop</bpmn:outgoing>
      <bpmn:outgoing>sl_f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="agt_3_capture" name="session capture — uncaptured work → tasks, decisions/learnings recorded (agents/session-capture)">
      <bpmn:extensionElements>
        <aef:uid value="sl_capture"/>
        <aef:position x="780.0" y="300.0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>sl_f5</bpmn:incoming>
      <bpmn:outgoing>sl_f6</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="agt_4_handover" name="fw handover --commit — generate + auto-commit + push to all remotes (T-1144)">
      <bpmn:extensionElements>
        <aef:uid value="sl_handover"/>
        <aef:position x="960.0" y="300.0"/>
        <aef:meta note="never end a session without a handover; PreCompact hook fires the same agent before /compact"/>
      </bpmn:extensionElements>
      <bpmn:incoming>sl_f6</bpmn:incoming>
      <bpmn:outgoing>sl_f7</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="agt_5_verify" name="push-verify — git fetch + rev-list left-right must be 0 0 (T-1277 slow-push); FF-land branch:master">
      <bpmn:extensionElements>
        <aef:uid value="sl_verify"/>
        <aef:position x="1140.0" y="300.0"/>
        <aef:meta note="OneDev push can time out client-side while the server accepted — timeout is NOT failure, verify by divergence count; FF is the one path satisfying T-100196 + T-2394"/>
      </bpmn:extensionElements>
      <bpmn:incoming>sl_f7</bpmn:incoming>
      <bpmn:outgoing>sl_f8</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="agt_gw_restart" name="restart requested?">
      <bpmn:extensionElements>
        <aef:uid value="sl_gw_restart"/>
        <aef:position x="1300.0" y="300.0"/>
        <aef:meta note=".restart-requested signal file, 5-min TTL, max 5 consecutive restarts (T-179)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>sl_f8</bpmn:incoming>
      <bpmn:outgoing>sl_f9</bpmn:outgoing>
      <bpmn:outgoing>sl_f10</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:intermediateCatchEvent id="agt_tmr_restart" name="wrapper cancel window">
      <bpmn:extensionElements>
        <aef:uid value="sl_tmr_restart"/>
        <aef:position x="1440.0" y="240.0"/>
        <aef:eventDef kind="timer" binding="PT3S"/>
        <aef:meta note="claude-fw wrapper: sleep 3 cancel window, then claude -c; SessionStart:resume reinjects handover context"/>
      </bpmn:extensionElements>
      <bpmn:incoming>sl_f9</bpmn:incoming>
      <bpmn:outgoing>sl_f11</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:endEvent id="agt_9_restarted" name="session auto-restarts (claude -c)">
      <bpmn:extensionElements>
        <aef:uid value="sl_done_restarted"/>
        <aef:position x="1580.0" y="240.0"/>
        <aef:meta terminalKind="success" state="restarted"/>
      </bpmn:extensionElements>
      <bpmn:incoming>sl_f11</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="hum_8_review" name="operator processes review queue — fw task review URLs from the handover">
      <bpmn:extensionElements>
        <aef:uid value="sl_review"/>
        <aef:position x="1440.0" y="100.0"/>
        <aef:meta note="class-correct URLs: /inception/&lt;id&gt; for inceptions, /review/&lt;id&gt; for partial-complete builds (T-2125); asynchronous — happens whenever the operator picks it up"/>
      </bpmn:extensionElements>
      <bpmn:incoming>sl_f10</bpmn:incoming>
      <bpmn:outgoing>sl_f12</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="agt_10_closed" name="session closed — next launch resumes from LATEST.md">
      <bpmn:extensionElements>
        <aef:uid value="sl_done_closed"/>
        <aef:position x="1580.0" y="100.0"/>
        <aef:meta terminalKind="success" state="closed"/>
      </bpmn:extensionElements>
      <bpmn:incoming>sl_f12</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="sl_f1" sourceRef="hum_0_launch" targetRef="agt_1_init">
      <bpmn:extensionElements><aef:uid value="sl_e1"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="sl_f2" sourceRef="agt_1_init" targetRef="agt_2_work">
      <bpmn:extensionElements><aef:uid value="sl_e2"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="sl_f3_loop" name="no — below critical, keep committing" sourceRef="agt_gw_budget" targetRef="agt_2_work">
      <bpmn:extensionElements><aef:uid value="sl_e3"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="sl_f4" sourceRef="agt_2_work" targetRef="agt_gw_budget">
      <bpmn:extensionElements><aef:uid value="sl_e4"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="sl_f5" name="yes — ≥285K, wrap-up only" sourceRef="agt_gw_budget" targetRef="agt_3_capture">
      <bpmn:extensionElements><aef:uid value="sl_e5"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="sl_f6" sourceRef="agt_3_capture" targetRef="agt_4_handover">
      <bpmn:extensionElements><aef:uid value="sl_e6"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="sl_f7" sourceRef="agt_4_handover" targetRef="agt_5_verify">
      <bpmn:extensionElements><aef:uid value="sl_e7"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="sl_f8" sourceRef="agt_5_verify" targetRef="agt_gw_restart">
      <bpmn:extensionElements><aef:uid value="sl_e8"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="sl_f9" name="yes — signal file present" sourceRef="agt_gw_restart" targetRef="agt_tmr_restart">
      <bpmn:extensionElements><aef:uid value="sl_e9"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="sl_f10" name="no — clean end" sourceRef="agt_gw_restart" targetRef="hum_8_review">
      <bpmn:extensionElements><aef:uid value="sl_e10"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="sl_f11" sourceRef="agt_tmr_restart" targetRef="agt_9_restarted">
      <bpmn:extensionElements><aef:uid value="sl_e11"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="sl_f12" sourceRef="hum_8_review" targetRef="agt_10_closed">
      <bpmn:extensionElements><aef:uid value="sl_e12"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
  </bpmn:process>
</bpmn:definitions>
