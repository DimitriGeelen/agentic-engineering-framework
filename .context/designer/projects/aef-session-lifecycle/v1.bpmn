<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:aef="http://anchorpoint.framework/aef/extensions"
                  id="Definitions_aef-session-lifecycle"
                  targetNamespace="https://aef.anchorpoint.dev/workflows">

  <!-- designer-corpus D3 (arc-014, T-2561): the AEF session lifecycle as actually
       operated. Sources of truth: CLAUDE.md §Session Start Protocol, §Context Budget
       Management (P-009, 225K/255K/285K ladder), §Session End Protocol, §Auto-Restart
       (T-179: signal file → wrapper sleep 3 → claude -c), T-1277 push-verify.
       Telemetry pick #3: handover ran 1387×. Timer flavor: the auto-restart cancel
       window is the one honest kind=timer in this process. Pair-draft v1. -->

  <!-- BPMN DI (visual layout) omitted in this demo; AEF generates it from node coordinates -->

  <bpmn:collaboration id="Collaboration_aef-session-lifecycle">
    <bpmn:participant id="Pool_session_lifecycle" name="AEF session lifecycle" processRef="Process_aef-session-lifecycle"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_aef-session-lifecycle" isExecutable="true">
    <bpmn:extensionElements>
      <aef:workflowMeta id="aef-session-lifecycle" version="1" schemaVersion="2" title="AEF session lifecycle (init → work loop → budget wrap-up → handover → push-verify)" tier_default="1"/>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_sl">
      <bpmn:lane id="human" name="Human · Sovereignty">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="hum" authority="sovereignty" height="160"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>hum_1_operator</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hum_2_operator</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="agent" name="Agent · Initiative">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="agt" authority="initiative" height="260"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>agt_10_session</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_9_session</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_1_session</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_2_work</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_4_session</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_5_fw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_6_push</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_3_budget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_7_restart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_8_wrapper</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="hum_1_operator" name="operator launches session (claude-fw)">
      <bpmn:extensionElements>
        <aef:uid value="sl_launch"/>
        <aef:position x="120.0" y="100.0"/>
        <aef:meta triggeredBy="operator starts claude-fw (optionally --termlink); wrapper owns the restart loop (T-179)"/>
      </bpmn:extensionElements>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="agt_10_session" name="session auto-restarts (claude -c)">
      <bpmn:extensionElements>
        <aef:uid value="sl_done_restarted"/>
        <aef:position x="1580.0" y="240.0"/>
        <aef:meta terminalKind="success" state="restarted"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_11</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="agt_9_session" name="session closed — next launch resumes from LATEST.md">
      <bpmn:extensionElements>
        <aef:uid value="sl_done_closed"/>
        <aef:position x="1580.0" y="100.0"/>
        <aef:meta terminalKind="success" state="closed"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_12</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="agt_1_session" name="session init — fw context init, read LATEST.md handover, set focus (Session Start Protocol)">
      <bpmn:extensionElements>
        <aef:uid value="sl_init"/>
        <aef:position x="260.0" y="300.0"/>
        <aef:meta note="Suggested First Action from handover; fw metrics for project state; post-compaction variant is fw resume status/sync"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="agt_2_work" name="work loop — task-gated work, commit cadence P-009 (commit every meaningful unit, 15-20 min)">
      <bpmn:extensionElements>
        <aef:uid value="sl_work"/>
        <aef:position x="440.0" y="300.0"/>
        <aef:meta note="nothing without a task (Tier-1 gate); each commit is a checkpoint — work up to last commit survives context loss"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="agt_4_session" name="session capture — uncaptured work → tasks, decisions/learnings recorded (agents/session-capture)">
      <bpmn:extensionElements>
        <aef:uid value="sl_capture"/>
        <aef:position x="780.0" y="300.0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="agt_5_fw" name="fw handover --commit — generate + auto-commit + push to all remotes (T-1144)">
      <bpmn:extensionElements>
        <aef:uid value="sl_handover"/>
        <aef:position x="960.0" y="300.0"/>
        <aef:meta note="never end a session without a handover; PreCompact hook fires the same agent before /compact"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="agt_6_push" name="push-verify — git fetch + rev-list left-right must be 0 0 (T-1277 slow-push); FF-land branch:master">
      <bpmn:extensionElements>
        <aef:uid value="sl_verify"/>
        <aef:position x="1140.0" y="300.0"/>
        <aef:meta note="OneDev push can time out client-side while the server accepted — timeout is NOT failure, verify by divergence count; FF is the one path satisfying T-100196 + T-2394"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="hum_2_operator" name="operator processes review queue — fw task review URLs from the handover">
      <bpmn:extensionElements>
        <aef:uid value="sl_review"/>
        <aef:position x="1440.0" y="100.0"/>
        <aef:meta note="class-correct URLs: /inception/&lt;id&gt; for inceptions, /review/&lt;id&gt; for partial-complete builds (T-2125); asynchronous — happens whenever the operator picks it up"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:outgoing>flow_12</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="agt_3_budget" name="budget critical?">
      <bpmn:extensionElements>
        <aef:uid value="sl_gw_budget"/>
        <aef:position x="620.0" y="300.0"/>
        <aef:meta note="P-009 ladder 225K ok→warn / 255K warn→urgent / 285K urgent→critical; budget-gate.sh BLOCKS source writes at critical — wrap-up only"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="agt_7_restart" name="restart requested?">
      <bpmn:extensionElements>
        <aef:uid value="sl_gw_restart"/>
        <aef:position x="1300.0" y="300.0"/>
        <aef:meta note=".restart-requested signal file, 5-min TTL, max 5 consecutive restarts (T-179)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:intermediateCatchEvent id="agt_8_wrapper" name="wrapper cancel window">
      <bpmn:extensionElements>
        <aef:uid value="sl_tmr_restart"/>
        <aef:position x="1440.0" y="240.0"/>
        <aef:eventDef kind="timer"/>
        <aef:meta note="claude-fw wrapper: sleep 3 cancel window, then claude -c; SessionStart:resume reinjects handover context"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:sequenceFlow id="flow_1" sourceRef="hum_1_operator" targetRef="agt_1_session">
      <bpmn:extensionElements><aef:uid value="sl_e1"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_2" sourceRef="agt_1_session" targetRef="agt_2_work">
      <bpmn:extensionElements><aef:uid value="sl_e2"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_3" name="no — below critical, keep committing" sourceRef="agt_3_budget" targetRef="agt_2_work">
      <bpmn:extensionElements><aef:uid value="sl_e3"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_4" sourceRef="agt_2_work" targetRef="agt_3_budget">
      <bpmn:extensionElements><aef:uid value="sl_e4"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_5" name="yes — ≥285K, wrap-up only" sourceRef="agt_3_budget" targetRef="agt_4_session">
      <bpmn:extensionElements><aef:uid value="sl_e5"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_6" sourceRef="agt_4_session" targetRef="agt_5_fw">
      <bpmn:extensionElements><aef:uid value="sl_e6"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_7" sourceRef="agt_5_fw" targetRef="agt_6_push">
      <bpmn:extensionElements><aef:uid value="sl_e7"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_8" sourceRef="agt_6_push" targetRef="agt_7_restart">
      <bpmn:extensionElements><aef:uid value="sl_e8"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_9" name="yes — signal file present" sourceRef="agt_7_restart" targetRef="agt_8_wrapper">
      <bpmn:extensionElements><aef:uid value="sl_e9"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_10" name="no — clean end" sourceRef="agt_7_restart" targetRef="hum_2_operator">
      <bpmn:extensionElements><aef:uid value="sl_e10"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_11" sourceRef="agt_8_wrapper" targetRef="agt_10_session">
      <bpmn:extensionElements><aef:uid value="sl_e11"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_12" sourceRef="hum_2_operator" targetRef="agt_9_session">
      <bpmn:extensionElements><aef:uid value="sl_e12"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
  </bpmn:process>
</bpmn:definitions>
