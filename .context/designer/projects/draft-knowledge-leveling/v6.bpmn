<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:aef="http://anchorpoint.framework/aef/extensions"
                  id="Definitions_draft-knowledge-leveling"
                  targetNamespace="https://aef.anchorpoint.dev/workflows">

  <bpmn:collaboration id="Collaboration_draft-knowledge-leveling">
    <bpmn:participant id="Pool_draft_knowledge_leveling" name="draft-knowledge-leveling (DRAFT)" processRef="Process_draft-knowledge-leveling"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_draft-knowledge-leveling" isExecutable="true">
    <bpmn:extensionElements>
      <aef:workflowMeta id="draft-knowledge-leveling" uuid="d7c7cfc0-536e-41bc-b105-60aa41377175" version="5" schemaVersion="2" title="AEF knowledge leveling — the learning lifecycle (capture channels → dormant → graduation → practice) — DRAFT" tier_default="1"/>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="agent" name="Agent · Initiative">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="agt" authority="initiative" height="260"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>agt_1_bugfix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_2_healing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_4_write</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="framework" name="Framework · Authority">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="fw" authority="authority" height="380"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>agt_3_organic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fw_7_refused</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fw_8_practice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fw_1_fw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fw_2_fw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fw_3_append</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fw_5_count</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fw_6_promotion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fw_4_dormant</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="agt_3_organic" name="organic insight during task work">
      <bpmn:extensionElements>
        <aef:uid value="kl_insight"/>
        <aef:position x="120.0" y="402.0"/>
        <aef:meta note="Capture channel 1 of 3 (converging — the sanctioned multi-start class, task-creation precedent). Operational reflection, pattern noticed across tasks, session-capture checklist"/>
      </bpmn:extensionElements>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:startEvent id="agt_1_bugfix" name="bugfix completion — learning prompt (G-016)">
      <bpmn:extensionElements>
        <aef:uid value="kl_bugfix"/>
        <aef:position x="120.0" y="520.0"/>
        <aef:meta note="Capture channel 2 of 3. update-task.sh emits an ADVISORY learning prompt at bugfix completion — G-016: 72% of bugfix tasks produced zero learnings before mitigation; no audit checks the bugfix-to-learning ratio (register gap still open)"/>
      </bpmn:extensionElements>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:startEvent id="agt_2_healing" name="healing resolve records the resolution">
      <bpmn:extensionElements>
        <aef:uid value="kl_healing"/>
        <aef:position x="120.0" y="600.0"/>
        <aef:meta note="Capture channel 3 of 3. agents/healing/lib/resolve.sh appends L-XXX directly (source: healing-loop) — the second writer to learnings.yaml (T-2672 emit-at-detected-indent scar lives here). Cross-map: this is aef-exception-handling's record step feeding this lifecycle"/>
      </bpmn:extensionElements>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="fw_7_refused" name="refused — already promoted">
      <bpmn:extensionElements>
        <aef:uid value="kl_done_already"/>
        <aef:position x="1080.0" y="60.0"/>
        <aef:meta terminalKind="error" state="already-promoted" note="promote.sh exit 1 — the only hard refusal in the whole machine. terminalKind=error per corpus precedent (832 round-4 Q2: exit-1 refusal = error-class terminal, 7 prior instances)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_9</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="fw_8_practice" name="practice active — surfaces in fw practices">
      <bpmn:extensionElements>
        <aef:uid value="kl_done_active"/>
        <aef:position x="1240.0" y="240.0"/>
        <aef:meta terminalKind="success" state="active" note="The feedback edge: active practices (and the learnings beneath them) are what fw recall / fw ask surface into future sessions — the antifragile loop this lifecycle exists to close. OUT OF SCOPE (different token — the whole store, not one learning): fw harvest (cross-project sync; 2+/3+ classification still unimplemented) and fw consolidate (dedup/prune; manual-only, no programmatic caller) — candidates for separate store-maintenance maps"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_13</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="fw_1_fw" name="fw context add-learning">
      <bpmn:extensionElements>
        <aef:uid value="kl_capture"/>
        <aef:position x="225.0" y="388.0"/>
        <aef:meta note="Routes to do_add_learning (agents/context/lib/learning.sh)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="fw_2_fw" name="fw fix-learned T-XXX">
      <bpmn:extensionElements>
        <aef:uid value="kl_fixlearned"/>
        <aef:position x="225.0" y="506.0"/>
        <aef:meta note="G-016 shortcut (bin/fw, hardcoded --source P-001; cite-blocks-not-lines per T-298 — line numbers drift between pins). Same do_add_learning path as channel 1"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="fw_3_append" name="append L-/PL- entry to learnings.yaml">
      <bpmn:extensionElements>
        <aef:uid value="kl_write"/>
        <aef:position x="440.0" y="140.0"/>
        <aef:meta note="Two writers, one store: learning.sh (channels 1+2) and resolve.sh (channel 3, indent-agnostic since T-2672). Fixed fields incl. application: TBD which NOTHING ever updates (promote re-derives counts by grepping task files). File is mixed-format (316 dash-form vs 234 legacy-indent, T-1369 scar) with 24 duplicate L-IDs (G-055 accepted-risk). DEAD: candidates tier — insertion anchor does not exist so the EOF fallback always runs, and the fw learnings candidates list renders empty forever"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="fw_5_count" name="count applications — string-match across task files">
      <bpmn:extensionElements>
        <aef:uid value="kl_count"/>
        <aef:position x="760.0" y="140.0"/>
        <aef:meta note="promote.sh count_applications: deliberate grep of the L-ID across .tasks/ and patterns.yaml; the application: TBD field in the learning entry is ignored entirely"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="agt_4_write" name="write practice P-/PP- to practices.yaml — status: active immediately">
      <bpmn:extensionElements>
        <aef:uid value="kl_practice"/>
        <aef:position x="1305.0" y="132.0"/>
        <aef:meta note="promote.sh atomic write (tmp + os.replace, T-100191 L-493 class). DEAD: ratification — no review/approval state exists between promote and active; the practice is live governance the moment the verb returns. derived_from defaults to D1; 5 of 12 live practices carry no directive at all. Multi-incoming = implicit XOR merge (mapping-v1 dialect): ready/almost/building parameterize the warning, they do not fork procedure"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:incoming>flow_11</bpmn:incoming>
      <bpmn:incoming>flow_12</bpmn:incoming>
      <bpmn:outgoing>flow_13</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="fw_6_promotion" name="promotion readiness?">
      <bpmn:extensionElements>
        <aef:uid value="kl_gw_ready"/>
        <aef:position x="920.0" y="140.0"/>
        <aef:meta note="Enforced enum, promote.sh status ladder: promoted (already a practice, refused exit 1) | ready (&gt;=3 applications) | almost (2) | building (&lt;2). THRESHOLD IS ADVISORY on the write path: warns below 3 and proceeds — so ready, almost AND building all reach the practice write; only promoted terminates. This gateway is the conformance-rail anchor (vocabulary-set vs lib/promote.sh)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
      <bpmn:outgoing>flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:intermediateCatchEvent id="fw_4_dormant" name="dormant — applications accumulate">
      <bpmn:extensionElements>
        <aef:uid value="kl_dormant"/>
        <aef:position x="600.0" y="140.0"/>
        <aef:meta state="dormant" note="THE GAP FINDING, embodied (v5 reframe — first mid-chain wait in the corpus): nothing automatic crosses this wait. The learning sits in the store while promote.sh-countable applications accumulate in task files; the audit &gt;=20 nudge (LIVE since T-2677 — first fire: 550 learnings WARN) only ADVISES; crossing requires `fw promote L-XXX` by agent/operator initiative. 832 rail 329: a named dormant state reads as designed honesty where canvas disconnection read as drafting accident"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:sequenceFlow id="flow_1" sourceRef="agt_3_organic" targetRef="fw_1_fw">
      <bpmn:extensionElements>
        <aef:uid value="kl_e1"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_2" sourceRef="agt_1_bugfix" targetRef="fw_2_fw">
      <bpmn:extensionElements>
        <aef:uid value="kl_e2"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_3" sourceRef="agt_2_healing" targetRef="fw_3_append">
      <bpmn:extensionElements>
        <aef:uid value="kl_e3"/>
        <aef:anchors sourcePort="S"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_4" sourceRef="fw_1_fw" targetRef="fw_3_append">
      <bpmn:extensionElements>
        <aef:uid value="kl_e4"/>
        <aef:anchors targetPort="W"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_5" sourceRef="fw_2_fw" targetRef="fw_3_append">
      <bpmn:extensionElements>
        <aef:uid value="kl_e5"/>
        <aef:anchors targetPort="SW"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_6" sourceRef="fw_3_append" targetRef="fw_4_dormant">
      <bpmn:extensionElements>
        <aef:uid value="kl_e6"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_7" name="fw promote L-XXX invoked" sourceRef="fw_4_dormant" targetRef="fw_5_count">
      <bpmn:extensionElements>
        <aef:uid value="kl_e7"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_8" sourceRef="fw_5_count" targetRef="fw_6_promotion">
      <bpmn:extensionElements>
        <aef:uid value="kl_e8"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_9" name="promoted" sourceRef="fw_6_promotion" targetRef="fw_7_refused">
      <bpmn:extensionElements>
        <aef:uid value="kl_e9"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_10" name="ready" sourceRef="fw_6_promotion" targetRef="agt_4_write">
      <bpmn:extensionElements>
        <aef:uid value="kl_e10"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_11" name="almost" sourceRef="fw_6_promotion" targetRef="agt_4_write">
      <bpmn:extensionElements>
        <aef:uid value="kl_e11"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_12" name="building" sourceRef="fw_6_promotion" targetRef="agt_4_write">
      <bpmn:extensionElements>
        <aef:uid value="kl_e12"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="flow_13" sourceRef="agt_4_write" targetRef="fw_8_practice">
      <bpmn:extensionElements>
        <aef:uid value="kl_e13"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
  </bpmn:process>

  <!-- BPMN DI (visual layout) omitted in this demo; AEF generates it from node coordinates -->
</bpmn:definitions>