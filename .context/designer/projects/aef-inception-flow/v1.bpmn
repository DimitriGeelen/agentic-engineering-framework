<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:aef="http://anchorpoint.framework/aef/extensions"
                  id="Definitions_aef-inception-flow"
                  targetNamespace="https://aef.anchorpoint.dev/workflows">

  <!-- designer-corpus D2 (arc-014, T-2558): the AEF inception flow as actually operated.
       Sources of truth: CLAUDE.md §Inception Discipline + §Recommendation-completeness gate
       (T-2204), C-001 artifact-first, lib/inception.sh (agent-blocked decide), T-1984 GO-scope
       traceability, T-1451 revisit_at. Inception encoded in the ratified G-3 collapsed
       subProcess form (sovereignty lane, go/no-go implied at boundary). Pair-draft v1. -->

  <bpmn:collaboration id="Collaboration_aef-inception-flow">
    <bpmn:participant id="Pool_inception_flow" name="AEF inception flow" processRef="Process_aef-inception-flow"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_aef-inception-flow" isExecutable="true">
    <bpmn:extensionElements>
      <aef:workflowMeta id="aef-inception-flow" version="1" schemaVersion="2" title="AEF inception flow (question → explore → go/no-go → build children)" tier_default="1"/>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_if">
      <bpmn:lane id="agent" name="Agent · Initiative">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="agt" authority="initiative" height="220"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>agt_0_question</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_1_file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_2_artifact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_gw_outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_4_children</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_5_archive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_6_go</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_7_closed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="human" name="Human · Sovereignty">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="hum" authority="sovereignty" height="180"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>hum_3_inception</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="agt_0_question" name="question identified">
      <bpmn:extensionElements>
        <aef:uid value="if_question"/>
        <aef:position x="120.0" y="120.0"/>
        <aef:meta triggeredBy="operator ask, 3+ exchange exploratory conversation (C-002), pickup proposal, or agent discovery"/>
      </bpmn:extensionElements>
      <bpmn:outgoing>if_f1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="agt_1_file" name="file inception — fw work-on --type inception (T-2204: recommendation + rationale required at filing)">
      <bpmn:extensionElements>
        <aef:uid value="if_file"/>
        <aef:position x="260.0" y="120.0"/>
        <aef:meta note="one inception = one question (Task Sizing); readiness gate requires >=1 IW-N Open Question before source reads"/>
      </bpmn:extensionElements>
      <bpmn:incoming>if_f1</bpmn:incoming>
      <bpmn:outgoing>if_f2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="agt_2_artifact" name="create research artifact FIRST (C-001) — docs/reports/T-XXX, dialogue log, incremental commits">
      <bpmn:extensionElements>
        <aef:uid value="if_artifact"/>
        <aef:position x="440.0" y="120.0"/>
        <aef:meta note="the thinking trail IS the artifact — conversations are ephemeral, files are permanent (T-194 origin)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>if_f2</bpmn:incoming>
      <bpmn:outgoing>if_f3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:subProcess id="hum_3_inception" name="explore the question — go/no-go">
      <bpmn:extensionElements>
        <aef:uid value="if_inception"/>
        <aef:position x="620.0" y="340.0"/>
        <aef:meta workflowType="inception" tier="1" note="collapsed inception (ratified G-3): go/no-go implied at boundary; owner derives from sovereignty lane; agent explores + recommends, decision is human via Watchtower /inception (fw inception decide agent-blocked under CLAUDECODE=1)"/>
        <aef:constituents>
          <aef:constituent id="if_c_spikes" name="run spikes / gather evidence (IW-N dispositions)" ref="docs/reports/T-XXX-*.md"/>
          <aef:constituent id="if_c_recommend" name="agent writes Recommendation GO/NO-GO/DEFER with rationale (DEFER only for evidence gaps, T-2144)"/>
          <aef:constituent id="if_c_decide" name="human records decision via Watchtower (sovereignty boundary)"/>
        </aef:constituents>
      </bpmn:extensionElements>
      <bpmn:incoming>if_f3</bpmn:incoming>
      <bpmn:outgoing>if_f4</bpmn:outgoing>
    </bpmn:subProcess>

    <bpmn:exclusiveGateway id="agt_gw_outcome" name="decision?">
      <bpmn:extensionElements>
        <aef:uid value="if_gw_outcome"/>
        <aef:position x="800.0" y="120.0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>if_f4</bpmn:incoming>
      <bpmn:outgoing>if_f5</bpmn:outgoing>
      <bpmn:outgoing>if_f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="agt_4_children" name="file build children (GO-scope traceability: inception_decisions / unlocks_inception_decision, T-1984)">
      <bpmn:extensionElements>
        <aef:uid value="if_children"/>
        <aef:position x="960.0" y="60.0"/>
        <aef:meta note="never continue building under the inception ID — separate build tasks per GO'd decision; commit-msg hook blocks after 2 exploration commits without a decision"/>
      </bpmn:extensionElements>
      <bpmn:incoming>if_f5</bpmn:incoming>
      <bpmn:outgoing>if_f7</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="agt_5_archive" name="archive: completed/ + episodic; on DEFER set revisit_at + revisit_evidence_needed (T-1451)">
      <bpmn:extensionElements>
        <aef:uid value="if_archive"/>
        <aef:position x="960.0" y="200.0"/>
        <aef:meta note="G-053 daily revisit scan re-surfaces DEFERs when their evidence condition is met"/>
      </bpmn:extensionElements>
      <bpmn:incoming>if_f6</bpmn:incoming>
      <bpmn:outgoing>if_f8</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="agt_6_go" name="build slices live">
      <bpmn:extensionElements>
        <aef:uid value="if_done_go"/>
        <aef:position x="1120.0" y="60.0"/>
        <aef:meta terminalKind="success" state="go"/>
      </bpmn:extensionElements>
      <bpmn:incoming>if_f7</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="agt_7_closed" name="question closed (revisit condition may re-open)">
      <bpmn:extensionElements>
        <aef:uid value="if_done_closed"/>
        <aef:position x="1120.0" y="200.0"/>
        <aef:meta terminalKind="success" state="closed"/>
      </bpmn:extensionElements>
      <bpmn:incoming>if_f8</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="if_f1" sourceRef="agt_0_question" targetRef="agt_1_file">
      <bpmn:extensionElements><aef:uid value="if_e1"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="if_f2" sourceRef="agt_1_file" targetRef="agt_2_artifact">
      <bpmn:extensionElements><aef:uid value="if_e2"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="if_f3" sourceRef="agt_2_artifact" targetRef="hum_3_inception">
      <bpmn:extensionElements><aef:uid value="if_e3"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="if_f4" sourceRef="hum_3_inception" targetRef="agt_gw_outcome">
      <bpmn:extensionElements><aef:uid value="if_e4"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="if_f5" name="GO" sourceRef="agt_gw_outcome" targetRef="agt_4_children">
      <bpmn:extensionElements><aef:uid value="if_e5"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="if_f6" name="NO-GO / DEFER" sourceRef="agt_gw_outcome" targetRef="agt_5_archive">
      <bpmn:extensionElements><aef:uid value="if_e6"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="if_f7" sourceRef="agt_4_children" targetRef="agt_6_go">
      <bpmn:extensionElements><aef:uid value="if_e7"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="if_f8" sourceRef="agt_5_archive" targetRef="agt_7_closed">
      <bpmn:extensionElements><aef:uid value="if_e8"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
  </bpmn:process>
</bpmn:definitions>
