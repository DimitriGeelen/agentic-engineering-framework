<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:aef="http://anchorpoint.framework/aef/extensions"
                  id="Definitions_aef-task-lifecycle"
                  targetNamespace="https://aef.anchorpoint.dev/workflows">

  <!-- designer-corpus D1 (arc-014, T-2555): the AEF task lifecycle as actually operated.
       Sources of truth this diagram documents: agents/task-create/update-task.sh (status
       machine, P-010/P-011 gates, T-193 partial-complete), agents/healing (issues loop),
       CLAUDE.md §Task Lifecycle. Pair-draft v1: agent-drafted, operator corrects in UI.
       v4 (T-2618): + completion-gate refusal loop (gates pass? -> blocked back to work),
       + horizon backlog (ready now? -> parked next/later -> promoted),
       + escalation-ladder / gate-variant / review-URL meta notes. -->

  <bpmn:collaboration id="Collaboration_aef-task-lifecycle">
    <bpmn:participant id="Pool_task_lifecycle" name="AEF task lifecycle" processRef="Process_aef-task-lifecycle"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_aef-task-lifecycle" isExecutable="true">
    <bpmn:extensionElements>
      <aef:workflowMeta id="aef-task-lifecycle" version="1" schemaVersion="2" title="AEF task lifecycle (captured → started-work ↔ issues → work-completed)" tier_default="1"/>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_tl">
      <bpmn:lane id="agent" name="Agent · Initiative">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="agt" authority="initiative" height="324.4744827586207"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>agt_1_work</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_14_task</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_2_create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_4_parked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_5_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_6_do</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_8_healing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_10_completion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_13_archive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_3_ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_9_issues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_11_gates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_12_unchecked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>agt_7_handoff</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="human" name="Human · Sovereignty">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="hum" authority="sovereignty" height="88"/>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>hum_1_partial</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="agt_1_work" name="work identified">
      <bpmn:extensionElements>
        <aef:uid value="tl_capture"/>
        <aef:position x="102.0" y="128.5"/>
        <aef:meta triggeredBy="operator request, pickup message, audit emit, or agent discovery"/>
      </bpmn:extensionElements>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="agt_14_task" name="task archived">
      <bpmn:extensionElements>
        <aef:uid value="tl_done"/>
        <aef:position x="1682.0" y="128.5"/>
        <aef:meta terminalKind="success"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_17</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="agt_2_create" name="create task — fw work-on (status: captured)">
      <bpmn:extensionElements>
        <aef:uid value="tl_create"/>
        <aef:position x="185.0" y="114.5"/>
        <aef:meta state="captured" note="nothing gets done without a task (Core Principle); G-020 blocks source edits until real ACs exist"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="agt_4_parked" name="parked in backlog (horizon: next/later)">
      <bpmn:extensionElements>
        <aef:uid value="tl_parked"/>
        <aef:position x="420.0" y="268.0"/>
        <aef:meta state="captured" note="captured tasks wait at horizon next/later; handover sorts them last and excludes later from Suggested First Action; shelving a started task auto-demotes status to captured (T-1068)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:incoming>flow_19</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="agt_5_start" name="start work (status: started-work, focus set)">
      <bpmn:extensionElements>
        <aef:uid value="tl_start"/>
        <aef:position x="420.0" y="114.5"/>
        <aef:meta state="started-work" note="fw work-on T-XXX; auto-sets horizon: now (T-1068 invariant)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="agt_6_do" name="do the work; tick Agent ACs progressively">
      <bpmn:extensionElements>
        <aef:uid value="tl_work"/>
        <aef:position x="600.0" y="114.5"/>
        <aef:meta state="started-work" note="commit cadence P-009; each AC ticked when its content lands (T-1831 C-4), not at the gate"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:incoming>flow_13</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
      <bpmn:outgoing>flow_18</bpmn:outgoing>
      <bpmn:outgoing>flow_19</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="agt_8_healing" name="healing loop (status: issues → diagnose → resolve)">
      <bpmn:extensionElements>
        <aef:uid value="tl_heal"/>
        <aef:position x="805.0" y="268.0"/>
        <aef:meta state="issues" note="fw task update --status issues auto-triggers healing diagnosis; resolution logged for pattern learning (antifragility D1). Escalation Ladder on repeat failure: A don't repeat → B technique → C tooling → D ways of working; unresolvable issues escalate to the operator"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
      <bpmn:outgoing>flow_20</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="agt_10_completion" name="completion gates: Agent ACs (P-010) + ## Verification commands (P-011)">
      <bpmn:extensionElements>
        <aef:uid value="tl_verify"/>
        <aef:position x="965.0" y="114.5"/>
        <aef:meta note="fw task update --status work-completed runs the Verification commands mechanically; any non-zero exit blocks completion. Variants: bug-class tasks need a substantive ## RCA (T-1550); render-surface tasks need a [REVIEW] Human AC (P-013); [REVIEWER] ACs auto-tick on reviewer PASS (T-1985)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:incoming>flow_20</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="agt_13_archive" name="archive: move to completed/, generate episodic memory">
      <bpmn:extensionElements>
        <aef:uid value="tl_archive"/>
        <aef:position x="1520.0" y="114.5"/>
        <aef:meta state="work-completed" note="date_finished stamped; decisions captured to context fabric; git mining populates Updates"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_15</bpmn:incoming>
      <bpmn:incoming>flow_16</bpmn:incoming>
      <bpmn:outgoing>flow_17</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="hum_1_partial" name="partial-complete: review Human ACs (Watchtower /review), tick, complete">
      <bpmn:extensionElements>
        <aef:uid value="tl_human_review"/>
        <aef:position x="1340.0" y="398.5"/>
        <aef:meta state="started-work" note="T-193: task stays in active/ owner:human; agent NEVER ticks a ### Human AC; human finalizes via fw task update --status work-completed. Handoff via fw task review T-XXX — emits the class-correct Watchtower URL (T-2125/T-2129)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_14</bpmn:incoming>
      <bpmn:outgoing>flow_16</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="agt_3_ready" name="ready to start now?">
      <bpmn:extensionElements>
        <aef:uid value="tl_gw_ready"/>
        <aef:position x="330.0" y="122.5"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="agt_9_issues" name="issues encountered?">
      <bpmn:extensionElements>
        <aef:uid value="tl_gw_issues"/>
        <aef:position x="836.0" y="122.5"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="agt_11_gates" name="gates pass?">
      <bpmn:extensionElements>
        <aef:uid value="tl_gw_gates"/>
        <aef:position x="1176.0" y="122.5"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_11</bpmn:incoming>
      <bpmn:outgoing>flow_12</bpmn:outgoing>
      <bpmn:outgoing>flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="agt_12_unchecked" name="unchecked Human ACs?">
      <bpmn:extensionElements>
        <aef:uid value="tl_gw_human"/>
        <aef:position x="1336.0" y="116.5"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_12</bpmn:incoming>
      <bpmn:outgoing>flow_14</bpmn:outgoing>
      <bpmn:outgoing>flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:intermediateThrowEvent id="agt_7_handoff" name="Handoff → dispatch loop">
      <bpmn:extensionElements>
        <aef:uid value="tl_handoff_dispatch"/>
        <aef:position x="637.0" y="282.0"/>
        <aef:link workflowRef="e32a518c-01de-4243-aafc-691cc99caf0d" name="aef-dispatch-loop" linkId=""/>
        <aef:meta note="heavy/parallel sub-work leaves this page: fw resolver dispatch / fw termlink dispatch — continues in aef-dispatch-loop (T-2586, T-2571 seam)"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_18</bpmn:incoming>
    </bpmn:intermediateThrowEvent>

    <bpmn:sequenceFlow id="flow_1" sourceRef="agt_1_work" targetRef="agt_2_create">
      <bpmn:extensionElements><aef:uid value="tl_e1"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_2" sourceRef="agt_2_create" targetRef="agt_3_ready">
      <bpmn:extensionElements><aef:uid value="tl_e2"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_3" name="now" sourceRef="agt_3_ready" targetRef="agt_5_start">
      <bpmn:extensionElements><aef:uid value="tl_e14"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_4" name="next/later — backlog" sourceRef="agt_3_ready" targetRef="agt_4_parked">
      <bpmn:extensionElements><aef:uid value="tl_e15"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_5" name="promoted — fw work-on T-XXX" sourceRef="agt_4_parked" targetRef="agt_5_start">
      <bpmn:extensionElements><aef:uid value="tl_e16"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_6" sourceRef="agt_5_start" targetRef="agt_6_do">
      <bpmn:extensionElements><aef:uid value="tl_e3"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_7" sourceRef="agt_6_do" targetRef="agt_9_issues">
      <bpmn:extensionElements><aef:uid value="tl_e4"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_8" name="yes — status: issues" sourceRef="agt_9_issues" targetRef="agt_8_healing">
      <bpmn:extensionElements><aef:uid value="tl_e5"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_9" name="resolved — back to work" sourceRef="agt_8_healing" targetRef="agt_6_do">
      <bpmn:extensionElements><aef:uid value="tl_e6"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_10" name="no" sourceRef="agt_9_issues" targetRef="agt_10_completion">
      <bpmn:extensionElements><aef:uid value="tl_e7"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_11" sourceRef="agt_10_completion" targetRef="agt_11_gates">
      <bpmn:extensionElements><aef:uid value="tl_e8"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_12" name="pass" sourceRef="agt_11_gates" targetRef="agt_12_unchecked">
      <bpmn:extensionElements><aef:uid value="tl_e17"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_13" name="blocked — unchecked AC / non-zero Verification; fix and retry" sourceRef="agt_11_gates" targetRef="agt_6_do">
      <bpmn:extensionElements><aef:uid value="tl_e18"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_14" name="yes — partial-complete (owner: human)" sourceRef="agt_12_unchecked" targetRef="hum_1_partial">
      <bpmn:extensionElements><aef:uid value="tl_e9"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_15" name="no — all ACs agent-verifiable" sourceRef="agt_12_unchecked" targetRef="agt_13_archive">
      <bpmn:extensionElements><aef:uid value="tl_e10"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_16" sourceRef="hum_1_partial" targetRef="agt_13_archive">
      <bpmn:extensionElements><aef:uid value="tl_e11"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_17" sourceRef="agt_13_archive" targetRef="agt_14_task">
      <bpmn:extensionElements><aef:uid value="tl_e12"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_18" name="heavy sub-work → dispatch" sourceRef="agt_6_do" targetRef="agt_7_handoff">
      <bpmn:extensionElements><aef:uid value="tl_e13"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_19" name="shelved — horizon next/later auto-demotes to captured (T-1068)" sourceRef="agt_6_do" targetRef="agt_4_parked">
      <bpmn:extensionElements><aef:uid value="tl_e19"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_20" name="resolved at gate — complete directly (issues → work-completed)" sourceRef="agt_8_healing" targetRef="agt_10_completion">
      <bpmn:extensionElements><aef:uid value="tl_e20"/></bpmn:extensionElements>
    </bpmn:sequenceFlow>
  </bpmn:process>
</bpmn:definitions>
