import json, os, shutil
with open('\''/opt/999-Agentic-Engineering-Framework/.claude/settings.json'\'') as f:
    data = json.load(f)
total = 0
broken = 0
stale_paths = 0
for event, entries in data.get('\''hooks'\'', {}).items():
    for entry in entries:
        for hook in entry.get('\''hooks'\'', []):
            cmd = hook.get('\''command'\'', '\'''\'')
            total += 1
            # T-2709: Claude Code expands ${CLAUDE_PROJECT_DIR} at hook-INVOCATION
            # time, so the literal string never exists on disk. doctor must expand it
            # the same way before statting, or every correctly-portable hook is
            # counted '\''broken'\'' and doctor emits a 25/25 FAIL over a healthy config
            # (plus contradictory advice: one remedy line says make paths portable,
            # the next says make them absolute). L-399 producer/consumer parity --
            # the generator learned the placeholder, this validator had not.
            cmd = cmd.replace('\''${CLAUDE_PROJECT_DIR}'\'', '\''/opt/999-Agentic-Engineering-Framework'\'')
            parts = cmd.split()
            # Check for portable '\''fw hook'\'' format (bare fw in PATH)
            if len(parts) >= 2 and parts[0] == '\''fw'\'':
                if shutil.which('\''fw'\''):
                    continue  # fw hook — portable, OK
                else:
                    broken += 1
                    continue
            # T-1222: vendored hook format (.agentic-framework/bin/fw hook or bin/fw hook)
            if len(parts) >= 2 and parts[0].endswith('\''/bin/fw'\''):
                fw_path = os.path.join('\''/opt/999-Agentic-Engineering-Framework'\'', parts[0])
                if os.path.isfile(fw_path) and os.access(fw_path, os.X_OK):
                    continue  # vendored fw hook — OK
                else:
                    broken += 1
                    continue
            # Old-style: absolute path — check if executable exists
            exe = None
            for p in parts:
                if '\''='\'' not in p:
                    exe = p
                    break
            if exe and not (os.path.isfile(exe) and os.access(exe, os.X_OK)):
                if not shutil.which(exe or '\'''\''):
                    broken += 1
            # Check for hardcoded absolute paths (path isolation violation)
            if '\''/agents/context/'\'' in cmd or '\''PROJECT_ROOT='\'' in cmd:
                stale_paths += 1
print(f'\''{total},{broken},{stale_paths}'\'')
