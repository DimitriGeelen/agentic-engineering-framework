# Agentic Engineering Framework — Scheduled Jobs (managed by cron-registry.yaml)
# Source of truth: /opt/999-Agentic-Engineering-Framework/.context/cron/agentic-audit.crontab (git-tracked)
# Installed to: /etc/cron.d/agentic-audit-999-agentic-engineering-framework
# Project: /opt/999-Agentic-Engineering-Framework
#
# flock wrapper (T-1331): every `fw audit ... --cron` is wrapped in
# `flock -n /var/lock/fw-audit-<section>.lock -c '...'` so overlapping
# cron fires skip rather than stack. Prevents orphan accumulation
# observed in T-1330 RCA (139 orphan processes, some running >24h).
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin

# Structural audits (30 min)
*/30 * * * * root flock -n /var/lock/fw-audit-999-structure.lock -c 'PROJECT_ROOT="/opt/999-Agentic-Engineering-Framework" "/opt/999-Agentic-Engineering-Framework/bin/fw" audit --section structure,compliance,quality,discovery --cron' 2>/dev/null

# Git traceability + episodic (hourly)
0 * * * * root flock -n /var/lock/fw-audit-999-traceability.lock -c 'PROJECT_ROOT="/opt/999-Agentic-Engineering-Framework" "/opt/999-Agentic-Engineering-Framework/bin/fw" audit --section traceability,episodic,discovery-trends --cron' 2>/dev/null

# Observations + gaps (6 hourly)
0 */6 * * * root flock -n /var/lock/fw-audit-999-observations.lock -c 'PROJECT_ROOT="/opt/999-Agentic-Engineering-Framework" "/opt/999-Agentic-Engineering-Framework/bin/fw" audit --section observations,gaps --cron' 2>/dev/null

# OE fast checks (30 min)
15,45 * * * * root flock -n /var/lock/fw-audit-999-oe-fast.lock -c 'PROJECT_ROOT="/opt/999-Agentic-Engineering-Framework" "/opt/999-Agentic-Engineering-Framework/bin/fw" audit --section oe-fast,oe-research --cron' 2>/dev/null

# OE hourly checks
30 * * * * root flock -n /var/lock/fw-audit-999-oe-hourly.lock -c 'PROJECT_ROOT="/opt/999-Agentic-Engineering-Framework" "/opt/999-Agentic-Engineering-Framework/bin/fw" audit --section oe-hourly --cron' 2>/dev/null

# OE daily checks
0 7 * * * root flock -n /var/lock/fw-audit-999-oe-daily.lock -c 'PROJECT_ROOT="/opt/999-Agentic-Engineering-Framework" "/opt/999-Agentic-Engineering-Framework/bin/fw" audit --section oe-daily --cron' 2>/dev/null

# OE weekly checks
0 9 * * 1 root flock -n /var/lock/fw-audit-999-oe-weekly.lock -c 'PROJECT_ROOT="/opt/999-Agentic-Engineering-Framework" "/opt/999-Agentic-Engineering-Framework/bin/fw" audit --section oe-weekly --cron' 2>/dev/null

# Full audit (daily)
0 8 * * * root flock -n /var/lock/fw-audit-999-full.lock -c 'PROJECT_ROOT="/opt/999-Agentic-Engineering-Framework" "/opt/999-Agentic-Engineering-Framework/bin/fw" audit --cron' 2>/dev/null

# Component docs regeneration (daily)
15 8 * * * root PROJECT_ROOT="/opt/999-Agentic-Engineering-Framework" "/opt/999-Agentic-Engineering-Framework/bin/fw" docs --all 2>/dev/null

# Cron audit file retention (daily)
0 9 * * * root cd "/opt/999-Agentic-Engineering-Framework" && python3 -c "import os,datetime; cutoff=str(datetime.date.today()-datetime.timedelta(days=7)); d='.context/audits/cron'; [os.remove(os.path.join(d,f)) for f in os.listdir(d) if f.endswith('.yaml') and len(f)>=15 and f[4]=='-' and f[:10]<cutoff]" 2>/dev/null

# Pickup inbox processor (1 min)
* * * * * root PROJECT_ROOT="/opt/999-Agentic-Engineering-Framework" "/opt/999-Agentic-Engineering-Framework/bin/fw" pickup process 2>/dev/null

# Weekly release tagging (Monday 10:00)
0 10 * * 1 root PROJECT_ROOT="/opt/999-Agentic-Engineering-Framework" "/opt/999-Agentic-Engineering-Framework/bin/fw" release tag-and-release 2>/dev/null

# TermLink hub + Claude + Watchtower liveness (1 min)
* * * * * root cd "/opt/999-Agentic-Engineering-Framework" && /opt/999-Agentic-Engineering-Framework/agents/monitor/liveness-check.sh 2>/dev/null

# Liveness check on startup
@reboot root cd "/opt/999-Agentic-Engineering-Framework" && LIVENESS_BOOT_MARKER=1 /opt/999-Agentic-Engineering-Framework/agents/monitor/liveness-check.sh 2>/dev/null
