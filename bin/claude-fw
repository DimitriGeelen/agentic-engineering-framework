#!/bin/bash
# claude-fw — Claude Code wrapper with auto-restart support
#
# Runs claude normally, then checks for a restart signal file
# written by checkpoint.sh when auto-handover fires at critical budget.
# If found (and fresh), auto-restarts with `claude -c` to continue.
#
# Usage:
#   claude-fw [claude-args...]          # Run with auto-restart enabled
#   claude-fw --no-restart [args...]    # Run without auto-restart
#   claude-fw --termlink [args...]      # Register as TermLink session for remote access
#   TL_CLAUDE_ENABLED=1 claude-fw      # Same via env var
#
# The restart signal file is .context/working/.restart-requested
# Written by: checkpoint.sh auto-handover at critical budget (T-186)
# Consumed by: this script on claude exit
#
# Part of: Agentic Engineering Framework (T-179 auto-restart, T-187 wrapper)

set -euo pipefail

# Parse our flags (before passing rest to claude)
AUTO_RESTART=true
TERMLINK_ENABLED="${TL_CLAUDE_ENABLED:-0}"
CLAUDE_ARGS=()

# T-2499: supervisor marker. Exported here so `command claude` and every hook
# subprocess it spawns (budget-gate, doctor) inherit it. Its presence = "this
# session is supervised by claude-fw, so the arc-012 budget-critical auto-restart
# loop can actually fire". A plain `claude` launch leaves it unset → the budget
# hook surfaces a loud "auto-restart will NOT fire" notice instead of silently
# writing a .restart-requested signal nobody consumes (the 300K→350K overrun bug).
export FW_CLAUDE_FW_SUPERVISED=1

for arg in "$@"; do
    case "$arg" in
        --no-restart)
            AUTO_RESTART=false
            ;;
        --termlink)
            TERMLINK_ENABLED=1
            ;;
        *)
            CLAUDE_ARGS+=("$arg")
            ;;
    esac
done

# TermLink session management
TERMLINK_SESSION=""

termlink_start() {
    if [ "$TERMLINK_ENABLED" != "1" ]; then return; fi
    if ! command -v termlink >/dev/null 2>&1; then
        echo "claude-fw: --termlink requested but termlink not found on PATH. Ignoring."
        TERMLINK_ENABLED=0
        return
    fi

    TERMLINK_SESSION="claude-master-$$"
    echo "claude-fw: Registering TermLink session: $TERMLINK_SESSION"

    # Spawn a persistent shell session that survives claude restarts
    termlink spawn --name "$TERMLINK_SESSION" \
        --tags "master,claude,framework" \
        --backend auto --shell \
        --wait --wait-timeout 15 2>/dev/null || {
        echo "claude-fw: TermLink spawn failed. Falling back to direct mode."
        TERMLINK_ENABLED=0
        TERMLINK_SESSION=""
        return
    }
    sleep 1
    echo "claude-fw: TermLink session ready. Remote access:"
    echo "  termlink attach $TERMLINK_SESSION"
    echo "  termlink pty output $TERMLINK_SESSION --strip-ansi"
}

termlink_inject() {
    local cmd="$1"
    termlink pty inject "$TERMLINK_SESSION" "$cmd" --enter >/dev/null 2>&1
}

termlink_cleanup() {
    if [ -n "$TERMLINK_SESSION" ]; then
        termlink pty inject "$TERMLINK_SESSION" "exit" --enter >/dev/null 2>&1 || true
        sleep 2
        termlink clean >/dev/null 2>&1 || true
    fi
}

# Cleanup on script exit
TERMINATOR_PID=""
trap 'termlink_cleanup; { [ -n "${TERMINATOR_PID:-}" ] && kill "$TERMINATOR_PID" 2>/dev/null; }; true' EXIT

# Signal file location (relative to git root)
find_signal_file() {
    local git_root
    git_root=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
    echo "$git_root/.context/working/.restart-requested"
}

# Check if signal file is fresh (< 5 minutes old)
is_signal_fresh() {
    local signal_file="$1"
    [ -f "$signal_file" ] || return 1

    local file_mtime now age
    file_mtime=$(stat -c %Y "$signal_file" 2>/dev/null) || return 1
    now=$(date +%s)
    age=$((now - file_mtime))

    if [ "$age" -lt 300 ]; then
        return 0  # Fresh
    else
        return 1  # Stale
    fi
}

# T-2373: budget-critical terminator (plain mode).
# The restart chain (checkpoint.sh writes .restart-requested at critical) only
# restarts AFTER claude exits — but in plain mode `command claude` runs in the
# foreground and nothing ends it, so the restart never fires (T-2372 bug).
# This watcher runs in the background alongside claude; on a FRESH signal written
# during the current run, it SIGTERMs (then SIGKILLs after a grace) the wrapper's
# claude child so the existing restart-on-exit branch executes.
# Fail-safe: if it can't find a child to kill, it no-ops — it never spurious-kills.
# Args: $1=wrapper PID, $2=signal file path, $3=this run's start epoch.
_terminator_watch() {
    set +e
    local wrapper_pid="$1" sigfile="$2" run_start="$3"
    local self="$BASHPID"
    local poll="${FW_TERMINATOR_POLL:-5}"
    local grace="${FW_TERMINATOR_GRACE:-5}"
    local mt now pids p
    while true; do
        sleep "$poll"
        # Wrapper gone → stop watching.
        kill -0 "$wrapper_pid" 2>/dev/null || return 0
        [ -f "$sigfile" ] || continue
        mt=$(stat -c %Y "$sigfile" 2>/dev/null || echo 0)
        now=$(date +%s)
        # Edge case a: only act on a signal written DURING this run (mtime >= run
        # start), so a leftover signal cannot instantly re-kill a resumed session.
        [ "$mt" -ge "$run_start" ] || continue
        # Align freshness window with is_signal_fresh (<5min).
        [ $((now - mt)) -lt 300 ] || continue
        # The wrapper's only direct children during a run are `claude` and this
        # watcher — so its direct children minus self == claude. No comm filter
        # (would miss claude when its comm is node/truncated).
        pids=$(pgrep -P "$wrapper_pid" 2>/dev/null | grep -v "^${self}$" || true)
        [ -n "$pids" ] || continue
        echo "" >&2
        echo "claude-fw: budget-critical signal detected — ending claude to trigger auto-restart." >&2
        for p in $pids; do kill -TERM "$p" 2>/dev/null || true; done
        sleep "$grace"
        for p in $pids; do kill -KILL "$p" 2>/dev/null || true; done
        return 0
    done
}

# T-3182 (arc-012): record WHY the continuous-run loop stopped.
#
# Every exit path out of the main loop below used to `exit` in silence. When the
# loop stopped, nothing on disk said so — which makes "the loop stopped" and "the
# loop was never armed" the same observable state. That is the false-green shape:
# a supervisor that quit reports exactly what a supervisor that had nothing to do
# reports. Answering "why is the loop not running?" then costs process forensics
# on PIDs and file mtimes, and only works while the evidence happens to survive.
#
# One line per loop event, appended to .context/working/continuous-run.jsonl.
# ITERATIONS are recorded too, not only exits — "it went round 3 times and then
# stopped because max-restarts" is a different fact from "it never started", and
# a log that only records endings cannot tell them apart either.
#
# Never fatal: this runs on exit paths, and a broken recorder must not change the
# wrapper's exit code or block a restart. Whole body is guarded.
_record_loop_event() {
    local event="$1" reason="$2" detail="${3:-}" code="${4:-}"
    {
        local root logf
        root=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
        [ -n "$root" ] || return 0
        [ -d "$root/.context/working" ] || return 0
        logf="$root/.context/working/continuous-run.jsonl"
        python3 - "$logf" "$event" "$reason" "$detail" "${code}" "${restart_count:-0}" "$$" <<'PY' 2>/dev/null || true
import json, sys, time
logf, event, reason, detail, code, count, pid = sys.argv[1:8]
rec = dict(
    ts=time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    event=event,
    reason=reason,
    restart_count=int(count) if str(count).isdigit() else 0,
    wrapper_pid=int(pid) if str(pid).isdigit() else 0,
)
if detail:
    rec["detail"] = detail
if str(code).lstrip("-").isdigit():
    rec["exit_code"] = int(code)
with open(logf, "a", encoding="utf-8") as f:
    f.write(json.dumps(rec) + "\n")
PY
    } 2>/dev/null || true
    return 0
}

# Set higher bash timeout for long framework operations (audit, fabric, embeddings)
# Default is 120s which is too short. T-501/T-435.
export BASH_DEFAULT_TIMEOUT_MS="${BASH_DEFAULT_TIMEOUT_MS:-300000}"

# T-2411: one-shot startup overview so the operator sees which project context the
# session is about to enter. Emitted before `command claude` takes the screen and
# NOT re-emitted on auto-restart iterations (the resumed session already knows where
# it is). Failures non-fatal — every lookup degrades to "(none)" / "(unknown)".
# Opt out: FW_NO_STARTUP_BANNER=1.
_print_startup_banner() {
    [ "${FW_NO_STARTUP_BANNER:-0}" = "1" ] && return 0
    local git_root project branch focus arc focus_file arc_file
    git_root=$(git rev-parse --show-toplevel 2>/dev/null) || git_root=""
    if [ -n "$git_root" ]; then
        project="${FW_PROJECT_NAME:-$(basename "$git_root")}"
        branch=$(git -C "$git_root" branch --show-current 2>/dev/null) || branch=""
        focus_file="$git_root/.context/working/focus.yaml"
        arc_file="$git_root/.context/working/arc-focus.yaml"
    else
        project="${FW_PROJECT_NAME:-(unknown)}"
        branch=""
        focus_file=""
        arc_file=""
    fi
    [ -z "$branch" ] && branch="(detached)"
    focus=""
    if [ -n "$focus_file" ] && [ -f "$focus_file" ]; then
        focus=$(grep -E '^current_task:' "$focus_file" 2>/dev/null | head -1 | sed -E 's/^current_task:[[:space:]]*//; s/[[:space:]]*$//') || focus=""
    fi
    [ -z "$focus" ] || [ "$focus" = "null" ] && focus="(none)"
    arc=""
    if [ -n "$arc_file" ] && [ -f "$arc_file" ]; then
        arc=$(grep -E '^current_arc:' "$arc_file" 2>/dev/null | head -1 | sed -E 's/^current_arc:[[:space:]]*//; s/[[:space:]]*$//') || arc=""
    fi
    [ -z "$arc" ] || [ "$arc" = "null" ] && arc="(none)"
    echo ""
    echo "  ╭─ claude-fw ──────────────────────────────────────────────"
    echo "  │ project : ${project}"
    echo "  │ branch  : ${branch}"
    echo "  │ focus   : ${focus}"
    echo "  │ arc     : ${arc}"
    echo "  ╰──────────────────────────────────────────────────────────"
    echo ""
}

# ── Restart policy (T-3243) ─────────────────────────────────────────────────
#
# `MAX_RESTARTS` used to be a hardcoded lifetime count. It was the wrong shape in
# three ways at once, all measured from this loop's own JSONL log:
#
#   1. LIFETIME, NOT RATE. Its stated purpose is "don't loop forever" — a claim
#      about RATE — but it counted TOTAL restarts for the wrapper's life, never
#      decaying. One wrapper performed 4 restarts across 28h52m (one per seven
#      hours) and was killed as a runaway. The only pathological interval in the
#      whole corpus is a 1m59s gap, and a lifetime counter is worst at catching
#      exactly that, because a spin costs it the same one unit as a 20-hour wait.
#
#   2. OFF BY ONE. It incremented, then tested `-ge`, so `MAX_RESTARTS=5`
#      permitted 4 — while the message and the log both reported 5. The number
#      that happened was not the number the record stated.
#
#   3. NOT CONFIGURABLE. `MAX_RESTARTS` has been in FW_CONFIG_REGISTRY
#      (lib/config.sh) the whole time. This script never read it, so
#      `fw config set MAX_RESTARTS 20` wrote .framework.yaml and changed nothing.
#
# The replacement is a SLIDING WINDOW: at most MAX_RESTARTS restarts in any
# RESTART_WINDOW seconds. Healthy hours-apart restarts never accumulate; a spin
# trips it within the window. Both legs are pinned by
# tests/unit/t3243_supervisor_restart_policy.bats — the cap firing on a spin is
# tested alongside the cap NOT firing on a healthy run, because "no longer fires"
# and "cannot fire" are the same observation without the control.

# _fw_cfg KEY DEFAULT — 3-tier read: FW_<KEY> env, .framework.yaml, default.
# Deliberately dependency-free: this script is vendored into consumer projects as
# .agentic-framework/bin/claude-fw and must not need lib/config.sh on disk.
_fw_cfg() {
    local key="$1" default="$2" val="" root=""
    eval "val=\"\${FW_${key}:-}\""
    if [ -n "$val" ]; then printf '%s' "$val"; return 0; fi
    root=$(git rev-parse --show-toplevel 2>/dev/null) || root=""
    if [ -n "$root" ] && [ -f "$root/.framework.yaml" ]; then
        val=$(python3 - "$root/.framework.yaml" "$key" <<'PY' 2>/dev/null || true
import sys
try:
    import yaml
    d = yaml.safe_load(open(sys.argv[1], encoding="utf-8")) or {}
except Exception:
    sys.exit(0)
cfg = d.get("config") if isinstance(d.get("config"), dict) else d
v = cfg.get(sys.argv[2]) if isinstance(cfg, dict) else None
if v is not None:
    print(v)
PY
)
    fi
    [ -n "$val" ] || val="$default"
    printf '%s' "$val"
}

# Main loop
restart_count=0                              # cumulative, for the log only
MAX_RESTARTS=$(_fw_cfg MAX_RESTARTS 5)       # per-window ceiling
RESTART_WINDOW=$(_fw_cfg RESTART_WINDOW 3600)
[[ "$MAX_RESTARTS"   =~ ^[0-9]+$ ]] || MAX_RESTARTS=5
[[ "$RESTART_WINDOW" =~ ^[0-9]+$ ]] || RESTART_WINDOW=3600

restart_times=()   # epoch seconds of restarts still inside the window

# _restart_budget_prune — drop restarts older than the window, set RESTART_SPENT.
#
# Sets a global rather than echoing: `spent=$(_restart_budget_prune)` would run
# the whole body in a command-substitution SUBSHELL, so the pruned array would be
# discarded and restart_times would grow without bound for the wrapper's life.
# The returned count would still be right — the prune is recomputed from scratch
# on every call — which is precisely why the leak would never show up in a test.
RESTART_SPENT=0
_restart_budget_prune() {
    local now kept=() t
    now=$(date +%s)
    for t in ${restart_times[@]+"${restart_times[@]}"}; do
        if [ $(( now - t )) -lt "$RESTART_WINDOW" ]; then kept+=("$t"); fi
    done
    restart_times=(${kept[@]+"${kept[@]}"})
    RESTART_SPENT="${#restart_times[@]}"
}

# _restart_budget_take — record a restart at now. Call only after a spend check.
_restart_budget_take() { restart_times+=("$(date +%s)"); }

# _continuous_armed — is a continuous run armed? Reads the same state file the
# Stop driver and `fw continuous` do. Absent/unreadable/disarmed → 1 (not armed),
# so this can only ever ADD a restart on an explicit opt-in, never on a default.
_continuous_armed() {
    local root state
    root=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
    state="${root}/.context/working/.continuous-mode.yaml"
    [ -f "$state" ] || return 1
    python3 - "$state" <<'PY' 2>/dev/null
import sys
try:
    import yaml
    d = yaml.safe_load(open(sys.argv[1], encoding="utf-8")) or {}
except Exception:
    sys.exit(1)
sys.exit(0 if d.get("enabled") is True else 1)
PY
}

# _continuous_halted — Brake 1, the halt file, same path stop-driver.sh:60 uses.
# It outranks every other vote here exactly as it does there.
_continuous_halted() {
    local root halt
    root=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
    halt="${FW_CONTINUOUS_HALT:-${root}/.context/working/.continuous-halt}"
    [ -f "$halt" ]
}

# Start TermLink session if requested (before main loop)
termlink_start

# T-2411: one-shot startup overview (before main loop — not re-emitted on restart).
_print_startup_banner

# T-3206 (arc-012): record that the loop is ARMED, before it can possibly end.
#
# T-3182 added six exit reasons and one iterate, which answers "why did it stop?"
# but leaves "is it running?" exactly where it was: with no start event, the log
# cannot come into existence until the loop is already over, so a live supervisor
# and an absent one both present as no file. Measured on a running wrapper — the
# defect T-3182 was filed to kill, surviving inside its own fix.
#
# Recorded here rather than inside the loop: this fires once per wrapper, so the
# log distinguishes "armed once, went round 3 times" from "armed 3 times", which
# an in-loop start event would flatten. Non-fatal like every other call site.
_record_loop_event start armed \
    "restart=$([ "$AUTO_RESTART" = false ] && echo disabled || echo enabled) max_restarts=${MAX_RESTARTS} window=${RESTART_WINDOW}s armed=$(_continuous_armed && echo yes || echo no) termlink=${TERMLINK_ENABLED:-0}"

while true; do
    # T-2373: record when this run started so the terminator only acts on a
    # signal written DURING the run (edge case a — not a leftover/stale signal).
    run_start_epoch=$(date +%s)
    # Run claude with user's arguments
    set +e
    if [ "$TERMLINK_ENABLED" = "1" ] && [ -n "$TERMLINK_SESSION" ]; then
        # Inject claude command into TermLink PTY session
        termlink_inject "claude ${CLAUDE_ARGS[*]}"
        # Wait for claude to exit by polling the PTY for shell prompt
        # We check if claude process is still running inside the session
        while true; do
            sleep 5
            # T-2373: budget-critical terminator (TermLink mode). If a fresh
            # signal appears while claude is still running, end the PTY claude
            # session so the restart-on-exit branch below fires.
            if [ "${FW_NO_TERMINATOR:-0}" != "1" ]; then
                _tl_sig=$(find_signal_file 2>/dev/null || true)
                if [ -n "$_tl_sig" ] && [ -f "$_tl_sig" ]; then
                    _tl_mt=$(stat -c %Y "$_tl_sig" 2>/dev/null || echo 0)
                    if [ "$_tl_mt" -ge "$run_start_epoch" ] && [ $(( $(date +%s) - _tl_mt )) -lt 300 ]; then
                        echo "claude-fw: budget-critical signal detected — ending TermLink claude session to trigger auto-restart."
                        termlink pty inject "$TERMLINK_SESSION" "/exit" --enter >/dev/null 2>&1 || true
                        sleep 2
                        exit_code=0
                        break
                    fi
                fi
            fi
            # Check if the session is still alive and claude is running
            if ! termlink ping "$TERMLINK_SESSION" >/dev/null 2>&1; then
                exit_code=1
                break
            fi
            # Check if claude process has exited (shell prompt returned)
            # Use a marker file approach: claude sets exit code on completion
            local_output=$(termlink pty output "$TERMLINK_SESSION" --lines 3 --strip-ansi 2>/dev/null) || true
            if echo "$local_output" | grep -qE '^\$|^❯|^➜|claude-fw:|^user@'; then
                exit_code=0
                break
            fi
        done
    else
        # T-2373: launch the budget-critical terminator alongside foreground
        # claude. It SIGTERMs claude on a fresh signal so the restart-on-exit
        # branch below can fire. Opt out with FW_NO_TERMINATOR=1.
        TERMINATOR_PID=""
        if [ "${FW_NO_TERMINATOR:-0}" != "1" ]; then
            _term_sig=$(find_signal_file 2>/dev/null || true)
            if [ -n "$_term_sig" ]; then
                _terminator_watch "$$" "$_term_sig" "$run_start_epoch" &
                TERMINATOR_PID=$!
            fi
        fi
        command claude "${CLAUDE_ARGS[@]}"
        exit_code=$?
        # Stop the watcher (no-op if it already fired/returned).
        if [ -n "${TERMINATOR_PID:-}" ]; then
            kill "$TERMINATOR_PID" 2>/dev/null || true
            wait "$TERMINATOR_PID" 2>/dev/null || true
            TERMINATOR_PID=""
        fi
    fi
    set -e

    # Don't auto-restart if disabled
    if [ "$AUTO_RESTART" = false ]; then
        _record_loop_event exit auto-restart-disabled "--no-restart or FW_NO_RESTART" "$exit_code"
        exit "$exit_code"
    fi

    # Check for restart signal
    signal_file=$(find_signal_file 2>/dev/null) || {
        # Not in a git repo — no signal file possible
        _record_loop_event exit no-git-repo "cwd is not inside a git worktree" "$exit_code"
        exit "$exit_code"
    }

    if [ -f "$signal_file" ] && is_signal_fresh "$signal_file"; then
        # T-3243: spend-check BEFORE taking the budget, so MAX_RESTARTS=N permits
        # exactly N restarts in the window rather than N-1. The old code
        # incremented first and tested `-ge`, which cost one restart silently.
        _restart_budget_prune; spent="$RESTART_SPENT"
        if [ "$spent" -ge "$MAX_RESTARTS" ]; then
            echo ""
            echo "claude-fw: Restart budget exhausted — ${spent}/${MAX_RESTARTS} restarts within the last ${RESTART_WINDOW}s."
            echo "  This is a RATE limit: it means the loop is spinning, not that it ran too long."
            echo "  Raise it with:  fw config set MAX_RESTARTS <n>   (or FW_RESTART_WINDOW=<seconds>)"
            echo "  Remove $signal_file to reset, then run 'claude -c' manually."
            rm -f "$signal_file"
            _record_loop_event exit max-restarts \
                "${spent} restarts within ${RESTART_WINDOW}s window >= MAX_RESTARTS=${MAX_RESTARTS}" 0
            exit 0
        fi
        _restart_budget_take
        restart_count=$((restart_count + 1))

        # Read signal metadata for display
        local_session=$(python3 -c "import json,sys; d=json.load(open('$signal_file')); print(d.get('session_id','?'))" 2>/dev/null) || local_session="?"
        local_tokens=$(python3 -c "import json,sys; d=json.load(open('$signal_file')); print(d.get('tokens',0))" 2>/dev/null) || local_tokens="?"
        # T-2363 (T-2158 S1): read optional directive from signal. When present,
        # export as FW_NEXT_DIRECTIVE so the resumed session's SessionStart
        # hook (T-2364) can surface it as additionalContext. Absent → no env
        # var set, behavior identical to pre-T-2363.
        local_directive=$(python3 -c "import json,sys; d=json.load(open('$signal_file')); v=d.get('directive',''); print(v if isinstance(v,str) else '')" 2>/dev/null) || local_directive=""

        echo ""
        _record_loop_event iterate restart "session=${local_session} tokens=${local_tokens}"
        echo "claude-fw: Auto-restart #${restart_count} (session: ${local_session}, tokens: ${local_tokens})"
        if [ -n "$local_directive" ]; then
            echo "  Directive: ${local_directive}"
            export FW_NEXT_DIRECTIVE="$local_directive"
        fi
        # T-3166: name the mode, so which kind of restart fired is visible in the
        # operator's terminal without reading the source.
        if [ "${FW_RESTART_MODE:-fresh}" = "continue" ]; then
            echo "  Restart mode: continue (claude -c — transcript restored, context NOT freed)"
        else
            echo "  Restart mode: fresh (new session, seeded from the handover)"
        fi
        echo "  Handover committed. Continuing in 3 seconds..."
        echo "  Press Ctrl+C to cancel."
        echo ""

        # Clean up signal before restart
        rm -f "$signal_file"

        # T-2376: mark this restart as a continuous-loop auto-restart. `claude -c`
        # emits SessionStart source "startup" (not "compact"/"resume"), so the
        # resume hook needs a way to tell an auto-restart continuation (advance
        # the loop + reinject the directive) from an unrelated cold `claude`
        # start. The sentinel sits beside the restart signal in .context/working/
        # and is consumed (rm) by post-compact-resume.sh on the next startup.
        restart_sentinel="$(dirname "$signal_file")/.auto-restart-pending"

        # Brief pause for user to cancel
        sleep 3

        # T-3168 (arc-012 F4): write the sentinel AFTER the cancel window, never
        # before it. It used to be written above the `sleep`, so pressing Ctrl+C at
        # the prompt that invites you to press Ctrl+C left it on disk with nothing
        # coming to consume it — and the operator's next cold `claude` start was then
        # read as a loop continuation: counter advanced, an old directive injected
        # into a session that never asked for one. On disk, a cancelled restart is
        # now indistinguishable from a restart that never fired.
        : > "$restart_sentinel" 2>/dev/null || true

        # T-3166 (arc-012 S2): start a FRESH session, not `claude -c`.
        #
        # The restart fires because context hit critical. `-c` continues the most
        # recent conversation, which restores the transcript — so the session comes
        # back holding the very context it restarted to escape, and the next
        # budget check is critical again. T-3163 measured that a session cannot
        # free its own context from the inside; the supervisor is the only thing
        # that can, and `-c` was it handing the context straight back.
        #
        # Nothing else has to change for the fresh session to know where it is:
        # T-2376 already wired SessionStart source "startup" behind the
        # .auto-restart-pending sentinel written just above, and
        # post-compact-resume.sh injects the handover, the directive and the
        # iteration counter on that branch.
        #
        # FW_RESTART_MODE=continue restores the pre-T-3166 behaviour for anyone
        # who wants transcript continuity and accepts that the budget does not drop.
        if [ "${FW_RESTART_MODE:-fresh}" = "continue" ]; then
            CLAUDE_ARGS=("-c")
        else
            CLAUDE_ARGS=()
        fi
        # Note: next loop iteration will use termlink_inject if TERMLINK_ENABLED
    elif [ -f "$signal_file" ]; then
        # Stale signal — clean up and exit
        local_age=$(( $(date +%s) - $(stat -c %Y "$signal_file" 2>/dev/null || echo 0) ))
        echo ""
        echo "claude-fw: Stale restart signal (${local_age}s old). Ignoring."
        rm -f "$signal_file"
        _record_loop_event exit stale-signal "signal ${local_age}s old, freshness window 300s" "$exit_code"
        exit "$exit_code"
    else
        # No signal. Two readings — "the operator quit" and "the loop broke" —
        # and until T-3243 both produced the same BEHAVIOUR: teardown. The record
        # separated them; nothing acted on the separation. Two of the three
        # wrapper deaths in continuous-run.jsonl are this branch, at 6h43m and
        # 9h01m after a healthy restart, both with exit_code=0.
        #
        # An ARMED continuous run is the operator having said, explicitly and in
        # advance, that this loop should keep going. Honour it here — bounded by
        # the same three brakes everything else in arc-012 answers to:
        #   1. the halt file (Brake 1, outranks everything — stop-driver.sh:81)
        #   2. the sliding restart budget (a claude that exits instantly cannot
        #      spin: re-arms spend the same budget as budget restarts)
        #   3. the operator's cancel window below
        # Not armed → exits exactly as before. The default is unchanged.
        if [ "$AUTO_RESTART" = true ] && _continuous_armed; then
            if _continuous_halted; then
                echo ""
                echo "claude-fw: Continuous run is armed, but the halt file is present. Stopping."
                _record_loop_event exit halted "halt file present; re-arm refused (Brake 1)" "$exit_code"
                exit "$exit_code"
            fi

            _restart_budget_prune; spent="$RESTART_SPENT"
            if [ "$spent" -ge "$MAX_RESTARTS" ]; then
                echo ""
                echo "claude-fw: Continuous run is armed, but the restart budget is exhausted"
                echo "  (${spent}/${MAX_RESTARTS} within the last ${RESTART_WINDOW}s). Stopping."
                _record_loop_event exit max-restarts \
                    "re-arm refused: ${spent} restarts within ${RESTART_WINDOW}s window >= MAX_RESTARTS=${MAX_RESTARTS}" "$exit_code"
                exit "$exit_code"
            fi
            _restart_budget_take
            restart_count=$((restart_count + 1))

            echo ""
            _record_loop_event iterate rearm \
                "clean exit (code=${exit_code}) with no signal; continuous run armed; budget $((spent + 1))/${MAX_RESTARTS} in ${RESTART_WINDOW}s"
            echo "claude-fw: Re-arm #${restart_count} — claude exited (code ${exit_code}) with no restart signal,"
            echo "  and a continuous run is armed. Relaunching in 5 seconds."
            echo "  To stop the run:   touch ${FW_CONTINUOUS_HALT:-$(dirname "$signal_file")/.continuous-halt}"
            echo "  Or disarm it:      fw continuous disarm"
            echo "  Or just press Ctrl+C."
            echo ""

            restart_sentinel="$(dirname "$signal_file")/.auto-restart-pending"
            sleep 5
            # Sentinel written AFTER the cancel window, per T-3168: a cancelled
            # re-arm must be indistinguishable on disk from one that never fired.
            : > "$restart_sentinel" 2>/dev/null || true

            if [ "${FW_RESTART_MODE:-fresh}" = "continue" ]; then
                CLAUDE_ARGS=("-c")
            else
                CLAUDE_ARGS=()
            fi
            continue
        fi

        # Not armed — the ORDINARY end of a supervised session, unchanged.
        _record_loop_event exit no-signal "claude exited without a restart signal" "$exit_code"
        exit "$exit_code"
    fi
done
