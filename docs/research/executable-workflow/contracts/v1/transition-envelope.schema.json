{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aef.geelenandcompany.com/ewcr/contracts/v1/transition-envelope.schema.json",
  "title": "EWCR v1 — Transition envelope",
  "version": 1,
  "description": "Freezes architecture-c9070637.md §7.3: every instance transition is an immutable envelope in the runner-owned append-only ledger — authenticated actor, timestamps, source/target state, node/edge, reason, bound-task content hash, input/output references, correlation IDs, and the prior accepted ledger position/hash (compare-and-append, §7.4). An agent proposes; only the runner admits.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope_id",
    "instance_id",
    "actor",
    "proposed_at",
    "source_state",
    "target_state",
    "node",
    "reason",
    "bound_task_content_hash",
    "correlation_id",
    "idempotency_key",
    "prior_position",
    "admission"
  ],
  "properties": {
    "envelope_id": {
      "type": "string",
      "pattern": "^env-[A-Za-z0-9._-]+$"
    },
    "instance_id": {
      "type": "string",
      "pattern": "^wi-[A-Za-z0-9._-]+$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "kind"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1,
          "description": "Per-agent authenticated identity. Host identity alone is refused as ambiguous (arch §7.3, §13 #12)."
        },
        "kind": {
          "enum": [
            "human",
            "agent",
            "runner",
            "watchtower",
            "external"
          ]
        },
        "auth_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Opaque, versioned reference into a registered catalogue. Never a path, shell string, or secret value (arch §6.2.1, §6.5)."
        }
      }
    },
    "proposed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "source_state": {
      "enum": [
        "created",
        "preflighted",
        "ready",
        "running",
        "waiting",
        "paused",
        "failed",
        "compensating",
        "completed",
        "cancelled"
      ]
    },
    "target_state": {
      "enum": [
        "created",
        "preflighted",
        "ready",
        "running",
        "waiting",
        "paused",
        "failed",
        "compensating",
        "completed",
        "cancelled"
      ]
    },
    "node": {
      "type": "string"
    },
    "edge": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "bound_task_content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ev-[A-Za-z0-9._-]+$"
      }
    },
    "output_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ev-[A-Za-z0-9._-]+$"
      }
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "description": "Duplicate delivery of the same key must return the original admission result, never a second effect (§7.3, §13 #7)."
    },
    "prior_position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "hash"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": -1
        },
        "hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "description": "index -1 / hash null only for the creating envelope."
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "proposed",
            "admitted",
            "refused"
          ]
        },
        "admitted_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "index",
            "hash"
          ],
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "refusal_id": {
          "type": "string",
          "pattern": "^ref-[A-Za-z0-9._-]+$"
        },
        "runner_identity": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "admitted"
              }
            }
          },
          "then": {
            "required": [
              "admitted_at",
              "position",
              "runner_identity"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "refused"
              }
            }
          },
          "then": {
            "required": [
              "refusal_id",
              "runner_identity"
            ]
          }
        }
      ]
    }
  }
}
