{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aef.geelenandcompany.com/ewcr/contracts/v1/refusal.schema.json",
  "title": "EWCR v1 — Refusal record",
  "version": 1,
  "description": "Freezes architecture-c9070637.md §2.5 (evidence of correct refusal: no side effect, durable record), §7.4 (refusal leaves the instance at its node with a recovery requirement; stale-position / conflict refusals for racing proposals), and the refusal routes of §13 scenarios 1–8, 11–13, 15–16, 18–20. reason_code values map one-to-one onto those scenarios.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "refusal_id",
    "ts",
    "instance_id",
    "requested_by",
    "refused_by",
    "reason_code",
    "detail",
    "scenario_refs",
    "side_effect",
    "recovery_requirement",
    "ledger_position"
  ],
  "properties": {
    "refusal_id": {
      "type": "string",
      "pattern": "^ref-[A-Za-z0-9._-]+$"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "instance_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^wi-[A-Za-z0-9._-]+$"
        },
        {
          "type": "null"
        }
      ],
      "description": "null only when refusing instance creation itself (§13 #1)."
    },
    "envelope_id": {
      "type": "string",
      "pattern": "^env-[A-Za-z0-9._-]+$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^att-[A-Za-z0-9._-]+$"
    },
    "requested_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "kind"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1,
          "description": "Per-agent authenticated identity. Host identity alone is refused as ambiguous (arch §7.3, §13 #12)."
        },
        "kind": {
          "enum": [
            "human",
            "agent",
            "runner",
            "watchtower",
            "external"
          ]
        },
        "auth_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Opaque, versioned reference into a registered catalogue. Never a path, shell string, or secret value (arch §6.2.1, §6.5)."
        }
      }
    },
    "refused_by": {
      "type": "string",
      "minLength": 1,
      "description": "Runner identity. Exactly one privileged runner admits or refuses (§7.3)."
    },
    "reason_code": {
      "enum": [
        "unratified_procedure",
        "unresolved_reference",
        "human_gate_skipped",
        "scope_mismatch",
        "missing_typed_input",
        "unmeasured_component_scope",
        "duplicate_delivery",
        "capability_unsupported",
        "direct_state_mutation",
        "ambiguous_identity",
        "task_hash_drift",
        "policy_or_capability_drift",
        "bypass_input",
        "cancellation_in_effect",
        "stale_position",
        "command_substitution",
        "deadline_expired"
      ]
    },
    "detail": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "scenario_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20
      },
      "description": "architecture-c9070637.md §13 acceptance-scenario numbers this refusal is evidence for."
    },
    "side_effect": {
      "const": false,
      "description": "A refusal is by definition before side effect (§7.4). A record claiming otherwise is invalid."
    },
    "recovery_requirement": {
      "type": "string",
      "minLength": 1
    },
    "ledger_position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "hash"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "description": "Position at which the refusal itself was appended — refusals are ledger entries, not log lines."
    },
    "expected_position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "hash"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": -1
        },
        "hash": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "description": "stale_position only: the position the loser proposed against."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reason_code": {
            "const": "stale_position"
          }
        }
      },
      "then": {
        "required": [
          "expected_position",
          "envelope_id"
        ]
      }
    }
  ]
}
