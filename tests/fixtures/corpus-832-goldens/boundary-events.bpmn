<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:aef="http://anchorpoint.framework/aef/extensions"
                  id="Definitions_process_1"
                  exporter="aef-workflow-designer"
                  targetNamespace="https://aef.anchorpoint.dev/workflows">

  <bpmn:collaboration id="Collaboration_process_1">
    <bpmn:participant id="Process_1" name="Process_1" processRef="Process_process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_process_1" isExecutable="true">
    <bpmn:extensionElements>
      <aef:workflowMeta id="process_1" version="1" schemaVersion="2" title="Process_1" tier_default="2"/>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="human" name="Human · Sovereignty">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="hum" authority="sovereignty" height="130"/>
        </bpmn:extensionElements>
      </bpmn:lane>
      <bpmn:lane id="framework" name="Framework · Authority">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="frw" authority="authority" height="130"/>
        </bpmn:extensionElements>
      </bpmn:lane>
      <bpmn:lane id="agent" name="Agent · Initiative">
        <bpmn:extensionElements>
          <aef:laneMeta abbr="agt" authority="initiative" height="320"/>
        </bpmn:extensionElements>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="lan_start_startevent">
      <bpmn:extensionElements>
        <aef:uid value="u1"/>
        <aef:position x="275.0" y="214.0"/>
        <aef:meta slug="startevent"/>
      </bpmn:extensionElements>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:intermediateThrowEvent id="lan_link_joker" name="joker">
      <bpmn:extensionElements>
        <aef:uid value="u2"/>
        <aef:position x="185.0" y="480.0"/>
      </bpmn:extensionElements>
    </bpmn:intermediateThrowEvent>

    <bpmn:boundaryEvent id="lan_link_batman" name="batman" attachedToRef="lan_1_subprocess" cancelActivity="true">
      <bpmn:extensionElements>
        <aef:uid value="u3"/>
        <aef:position x="185.0" y="349.0"/>
        <aef:meta hostRef="n_136434fa" interrupting="true"/>
        <aef:boundaryPos value="0.5326"/>
      </bpmn:extensionElements>
    </bpmn:boundaryEvent>

    <bpmn:boundaryEvent id="lan_link_superman" name="superman" attachedToRef="lan_3_task" cancelActivity="true">
      <bpmn:extensionElements>
        <aef:uid value="u4"/>
        <aef:position x="781.0" y="140.0"/>
        <aef:meta hostRef="n_8b3cd381" interrupting="true"/>
      </bpmn:extensionElements>
    </bpmn:boundaryEvent>

    <bpmn:boundaryEvent id="lan_link_wonder" name="wonder woman" attachedToRef="lan_1_subprocess" cancelActivity="true">
      <bpmn:extensionElements>
        <aef:uid value="u5"/>
        <aef:position x="412.0" y="349.0"/>
        <aef:meta hostRef="n_136434fa" interrupting="true"/>
        <aef:boundaryPos value="0.7935"/>
      </bpmn:extensionElements>
    </bpmn:boundaryEvent>

    <bpmn:subProcess id="lan_1_subprocess" name="SubProcess_1">
      <bpmn:extensionElements>
        <aef:uid value="u6"/>
        <aef:position x="204.0" y="78.0"/>
      </bpmn:extensionElements>
    </bpmn:subProcess>

    <bpmn:task id="lan_3_task" name="Task_2">
      <bpmn:extensionElements>
        <aef:uid value="u7"/>
        <aef:position x="795.0" y="75.0"/>
      </bpmn:extensionElements>
    </bpmn:task>

    <bpmn:task id="lan_4_compensationtask" name="CompensationTask">
      <bpmn:extensionElements>
        <aef:uid value="u8"/>
        <aef:position x="795.0" y="249.0"/>
      </bpmn:extensionElements>
    </bpmn:task>

    <bpmn:task id="lan_2_task" name="Task_1">
      <bpmn:extensionElements>
        <aef:uid value="u9"/>
        <aef:position x="431.0" y="192.0"/>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_1</bpmn:incoming>
    </bpmn:task>

    <bpmn:sequenceFlow id="flow_1" sourceRef="lan_start_startevent" targetRef="lan_2_task">
      <bpmn:extensionElements>
        <aef:uid value="u10"/>
      </bpmn:extensionElements>
    </bpmn:sequenceFlow>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_process_1">
    <bpmndi:BPMNPlane id="BPMNPlane_process_1" bpmnElement="Process_process_1">
      <bpmndi:BPMNShape id="BPMNShape_lan_start_startevent" bpmnElement="lan_start_startevent">
        <dc:Bounds x="275.0" y="214.0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_lan_link_joker" bpmnElement="lan_link_joker">
        <dc:Bounds x="185.0" y="480.0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_lan_link_batman" bpmnElement="lan_link_batman">
        <dc:Bounds x="185.0" y="349.0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_lan_link_superman" bpmnElement="lan_link_superman">
        <dc:Bounds x="781.0" y="140.0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_lan_link_wonder" bpmnElement="lan_link_wonder">
        <dc:Bounds x="412.0" y="349.0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_lan_1_subprocess" bpmnElement="lan_1_subprocess">
