# T-2866: both revisit signals are generated by revisit-due-scan.sh and rely on an
# absent==empty contract — the scanner REMOVES the file when the set is empty. A
# tracked copy can never be absent after a checkout, so git would restore a stale
# signal and the handover would report it as current. Pinned by
# tests/unit/revisit_signal_untracked.bats.
.context/working/.revisits-due.txt
.context/working/.revisits-undated.txt
.playwright-mcp/
.termlink-task
.claude/scheduled_tasks.lock
.context/working/.tier0-approval
